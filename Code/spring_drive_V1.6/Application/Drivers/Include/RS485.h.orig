#ifndef __RS485_H__
#define __RS485_H__

#include "driver_config.h"


#define RS485_CH1_DIR_PART  GPIOA
#define RS485_CH1_DIR_PIN		PIN1

#define RS485_CH2_DIR_PART	GPIOA
#define RS485_CH2_DIR_PIN		PIN7

#define RS485_CH1_RX() 		GPIO_ClrBit(RS485_CH1_DIR_PART,RS485_CH1_DIR_PIN)
#define RS485_CH1_TX()		GPIO_SetBit(RS485_CH1_DIR_PART,RS485_CH1_DIR_PIN);

#define RS485_CH2_RX() 		GPIO_ClrBit(RS485_CH2_DIR_PART,RS485_CH2_DIR_PIN)
#define RS485_CH2_TX()		GPIO_SetBit(RS485_CH2_DIR_PART,RS485_CH2_DIR_PIN)


#define RS485_CH1_UART   UART0
#define RS485_CH2_UART   UART2

#define RS485_CH1_INTERRUPT  IRQ16_31_UART0  //16-31 ∂‘”¶IRQ16 - IRQ 31
#define RS485_CH2_INTERRUPT  IRQ16_31_UART2

#define RS485_CH1_INTERRUPT_NUMBER IRQ28_IRQ
#define RS485_CH2_INTERRUPT_NUMBER IRQ29_IRQ

#define RS485_CH1_RX_LEN 64UL
#define RS485_CH2_RX_LEN 32UL


void RS485_Chnnel1_Cfg(void);
void RS485_Chnnel2_Cfg(void);

void RS485_Ch1_SendData(uint8_t* data,uint32_t dataLength);
void RS485_Ch2_SendData(uint8_t* data,uint32_t dataLength);
void RS485_CH1_Clear_Cache(void);

uint32_t RS485_CH1_GetData(uint8_t *data);
uint32_t RS485_CH2_GetData(uint8_t *data);


extern	uint8_t __RS485_Ch1_RX_Finish;
extern	uint8_t __RS485_Ch2_RX_Finish;
extern	uint8_t __UART2_RX_Finish;
	
extern uint32_t RS485_Ch2_RXIndex;
extern uint8_t  RS485_Ch2_Buffer[RS485_CH2_RX_LEN];

extern uint32_t RS485_Ch1_RXIndex;
extern uint8_t  RS485_Ch1_Buffer[RS485_CH1_RX_LEN];



#endif
