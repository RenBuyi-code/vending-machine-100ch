#include "RS485.h"

uint8_t __RS485_Ch1_RX_Finish = 0;
uint8_t __RS485_Ch2_RX_Finish = 0;
uint8_t __UART2_RX_Finish=0;

uint32_t RS485_Ch2_RXIndex = 0;
uint8_t  RS485_Ch2_Buffer[RS485_CH2_RX_LEN]={0};

uint32_t RS485_Ch1_RXIndex = 0;
uint8_t  RS485_Ch1_Buffer[RS485_CH1_RX_LEN]={0};


void RS485_Chnnel1_Cfg(void)
{
	uart_init(RS485_CH1_UART,9600,1,0,1);		
	
	GPIO_Init(RS485_CH1_DIR_PART,RS485_CH1_DIR_PIN,1,0,0,0);
	
	IRQ_Connect(RS485_CH1_INTERRUPT, RS485_CH1_INTERRUPT_NUMBER, 1); //RS485 CH1 IRQ cfg
	
	RS485_CH1_RX();
}

void RS485_Chnnel2_Cfg(void)
{
	uart_init(RS485_CH2_UART,9600,1,0,1);
	
	GPIO_Init(RS485_CH2_DIR_PART,RS485_CH2_DIR_PIN,1,0,0,0);
	
	IRQ_Connect(RS485_CH2_INTERRUPT, RS485_CH2_INTERRUPT_NUMBER, 2);//RS485 CH2 IRQ cfg
	
	RS485_CH2_RX();

}

void RS485_Ch1_SendData(uint8_t* data,uint32_t dataLength)
{
			RS485_CH1_TX();
	
			SendData(RS485_CH1_UART,data,dataLength);
	
			RS485_CH1_RX();
}


void RS485_Ch2_SendData(uint8_t* data,uint32_t dataLength)
{
	
		  RS485_CH2_TX();		
	
			SendData(RS485_CH2_UART,data,dataLength);
	
			RS485_CH2_RX();

}


uint32_t RS485_CH1_GetData(uint8_t *data)
{
	uint32_t len = 0;
	
	if(RS485_Ch1_RXIndex != 0)
	{
		NVIC_DisableIRQ(RS485_CH1_INTERRUPT_NUMBER);		//从UART_RXBuffer读取数据过程中要关闭中断，防止读写混乱	
		memcpy(data, RS485_Ch1_Buffer, RS485_Ch1_RXIndex);
		memset(RS485_Ch1_Buffer,0,RS485_Ch1_RXIndex);
		len = RS485_Ch1_RXIndex;
		RS485_Ch1_RXIndex = 0;
			
		
		NVIC_EnableIRQ(RS485_CH1_INTERRUPT_NUMBER);
	}
	
	return len;
}


uint32_t RS485_CH2_GetData(uint8_t *data)
{
	uint32_t len = 0;
	
	if(RS485_Ch2_RXIndex != 0)
	{
		NVIC_DisableIRQ(RS485_CH2_INTERRUPT_NUMBER);		//从UART_RXBuffer读取数据过程中要关闭中断，防止读写混乱
		memcpy(data, RS485_Ch2_Buffer, RS485_CH2_RX_LEN);
		len = RS485_Ch2_RXIndex;
		RS485_Ch2_RXIndex = 0;
		NVIC_EnableIRQ(RS485_CH2_INTERRUPT_NUMBER);
	}
	
	return len;
}

void RS485_CH1_Clear_Cache(void)
{
	memset(RS485_Ch1_Buffer,0,RS485_Ch1_RXIndex);
	RS485_Ch1_RXIndex =0;
}
