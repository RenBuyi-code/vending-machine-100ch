static uint8_t check_xy(uint8_t x,uint8_t y)
{
		uint8_t  err =0;

		if( x>10 || y>10 || x==0 || y==0 )
		{		
			err = 0xEE;		
		}	
		
		err = 0;	
		
		return err;
}

static uint8_t check_ir(void)
{
		uint32_t delay_tick=0;
		uint8_t err =0;
	
		tick_reset(); //清空计数器
		delay_tick = 10+get_tick(); //100ms*10 = 1S
	
		GPIO_ClrBit(IR_PART,IR_PIN);
	
		while(1==1)
		{
			if(GPIO_GetBit(IR_PART,IR_PIN) ==1 ) //检测光栅有没有被挡住 ,IO没有被拉低
			{
						break;
			}
			else if (delay_tick <= get_tick()) //超时退出 光栅被挡住 
			{	
						err = 0XEE;		
				
						vm_control.ir_flag = IR_NONE;  //没有检测到光栅
						current_result = result_vm_output; 
					
						break;				
			}			
		}
		return err;

}

static uint8_t check_motor(uint8_t x , uint8_t y)
{
		uint32_t delay_tick=0;
		uint8_t err =0;
		uint32_t delay_cnt = 0xFFFFF;
	
		tick_reset(); //清空计数器，重新装载
		delay_tick = get_tick()+5; //500ms
				
		while( --delay_cnt ){__nop();}//消抖
		
		while(1)//等待电机跑出缺口位置
		{
			
			if(GPIO_GetBit(motorDrive_tab[y].fb_part,motorDrive_tab[y].fb_pin) == 0)//等待跑出缺口位置
		  {		 
				 if(GPIO_GetBit(motorDrive_tab[y].fb_part,motorDrive_tab[y].fb_pin) == 0)
				 {
						Motor_FB_EXTI_Enable(y);
						break;
				 }										
		  }
			else if(delay_tick <= get_tick()) //超时 电机被卡住或者没电机 
			{
							GPIO_ClrBit(motorDrive_tab[x].part_x,motorDrive_tab[x].pin_x);
							GPIO_SetBit(motorDrive_tab[y].part_y,motorDrive_tab[y].pin_y);
				
							Motor_FB_EXTI_Disable(y);
							IR_EXTI_DISABLE();	
							TIMR_Stop(Motor_TIMR);
							TIMR_Stop(IR_TIMR);
							err = 0xEE;			
				
							vm_control.load_number = current_num;   //获取当前通道
							vm_control.load_flag = MOTOR_ERR;				//没检测到电机,可能是线断了
							current_result = result_vm_output;		  //输出
											
				 			break;
			}
		}
		
		return err;
}

int Motor_On(uint8_t number)//出货
{
	    uint8_t x =0;
		uint8_t y =0;
		uint8_t  err=0;
	
			
		err = current_num_updata(number);
		if(err == 0xEE)return -1;

		x =	get_x_num(number);
		y = get_y_num(number);
		
		err = check_xy(x,y);  
		if(err == 0xEE)return -1;
		
		if(vm_control.ir_flag == IR_CHECK_OPEN)
		{
				err = check_ir();		
				if(err == 0xEE)return -1;
				TIMR_Start(IR_TIMR);		//开红外超时检测	
				IR_EXTI_ENABLE();	//打开红外引脚中断
		}
		else if(vm_control.ir_flag == IR_CHECK_CLOSE) 
		{
				IR_EXTI_DISABLE();
		}
		else 
		{
				return -1; //这一步很重要
		}
		
		
	  TIMR_Start(Motor_TIMR); //开电机超时检测
		UART_Close(RS485_CH1_UART);	//出货的时候把串口锁了 防止...	
		
		GPIO_SetBit(motorDrive_tab[x].part_x,motorDrive_tab[x].pin_x);
		GPIO_ClrBit(motorDrive_tab[y].part_y,motorDrive_tab[y].pin_y);		
		
		
		err = check_motor(x,y);
		if(err == 0xEE)
		{
				
				UART_Open(RS485_CH1_UART);
				return -1;
		}
		
		if(__MotorIsBuys == 0)
		{
			__MotorIsBuys = 1;
		}
		
		return 1;
}


int Motor_Off(uint8_t number)//停止出货
{
	 	uint8_t x =0;
		uint8_t y =0;
		uint8_t err=0;
	

		x =	get_x_num(number);
		y = get_y_num(number);
		
		err = check_xy(x,y);  
		if(err == 0xEE)return -1;

		
		if( x>10 || y>10 || x==0 || y==0 )
		{
			return -1;
		}
		else
		{
				GPIO_ClrBit(motorDrive_tab[x].part_x,motorDrive_tab[x].pin_x);
				GPIO_SetBit(motorDrive_tab[y].part_y,motorDrive_tab[y].pin_y);
				Motor_FB_EXTI_Disable(y);	
				TIMR_Stop(Motor_TIMR); //停止电机超时检测
			
				vm_control.load_number = 	current_num;	
				current_num = 0;//这里把当前货道清零 并已赋值给结构体
		}
		
		if(__MotorIsBuys == 1)
		{
			__MotorIsBuys =0;
		}
		return 1;
}

