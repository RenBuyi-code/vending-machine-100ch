}


/*********************************************************************************************************
* 功 能 : 串口发送不了的数据进入缓存
* 入 口 : 'port' 串口编号
*         'Data' 进入缓存的消息数据
* 返 回 : 1> UART_TXD_FLOODL 发送消息进入缓存满 (失败)
*         2> UART_TXD_OK   发送消息进入缓存OK
* 说 明 : 1> 内部模式 用户不能调用
*********************************************************************************************************/

static void UartTxInBuf (u8_t port, u8_t Data)
{
    stUART_BUF_DEF *p     = NULL;
    stUART_CTRL    *pCtrl = NULL;  


    p     = &UartBuf[port].Tx;                      // 取对应串口缓存
    pCtrl = &p->stCtrl;                             //
    if ( !pCtrl->bit.bEn ) {                        //
        return ;                                    // 发送特征值 
    }
    
    if (pCtrl->bit.Cnt < p->BufSize) {              // 处理发送缓存计数器
        pCtrl->bit.Cnt++;                           // 发送缓存计数器加1
        p->pBuf[pCtrl->bit.In++] = Data;            // 来不及发送的数据进发送缓存
        if (pCtrl->bit.In >= p->BufSize) {          // 处理发送进缓存计数器
            pCtrl->bit.In = 0;                      // 复位发送进缓存计数器
        }
    }
}


