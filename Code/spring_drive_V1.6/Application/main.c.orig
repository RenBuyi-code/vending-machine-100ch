#include "driver_config.h"

#define ENABLE_WDT 0

static const uint8_t hello[] = "Hello World";

static void board_init(void)
{

    SystemInit();
		
    drive_address_config();  //初始化设备地址

    led_init();							 //初始化LED
    ir_check_init();
    motor_init();
    rs485_channel1_config();
    rs485_channel2_config();		 
    hw_timr_Init();
    lock_io_Init();
    system_tick_init();
	
    __is_ask = TRUE;//开机先问一下
    ask_ambient();
	
		rs485_channel1_send((uint8_t*)hello,sizeof(hello));

#if ENABLE_WDT >0u
    WDT_Init(WDT, SystemCoreClock*10, WDT_MODE_RESET);	//每5秒需要喂狗一次
    WDT_Start(WDT);
#endif
}

int main(void)
{
    uint16_t cnt=0;
    board_init();

    while(TRUE == TRUE)
    {
        switch(cnt)
        {
        case 1 :
        {
#if ENABLE_WDT >0u
            WDT_Feed(WDT);
#endif
        }
        break;

        case 2 :
        {
            rs485_ch1_recv();
#if ENABLE_WDT >0u
            WDT_Feed(WDT);
#endif
        }
        break;

        case 3 :
        {
            rs485_ch1_reply();
#if ENABLE_WDT >0u
            WDT_Feed(WDT);
#endif
        }
        break;

        case 4:
        {
            ask_ambient(); //询问环境传感器
#if ENABLE_WDT >0u
            WDT_Feed(WDT);
#endif
        }
        break;

        case 5:
        {
            rs485_ch2_recv();
#if ENABLE_WDT >0u
            WDT_Feed(WDT);
#endif
        }
        break;
				case 6:
				{
						if(led_tick >= 7) //700MS 闪灯
						{
							LED_INV();
							led_tick =0 ;
						}
				
				
				}
        default:
            cnt=0;
            break;

        }
        cnt++;
    }
}


